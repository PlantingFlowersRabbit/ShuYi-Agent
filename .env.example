# 书翼 Agent / NovelVoice 兼容配置。不要在本文件填写真实密钥。
NOVELVOICE_API_TOKEN=
NOVELVOICE_CORS_ORIGINS=http://127.0.0.1:5173
NOVELVOICE_DEVICE=cpu
NOVELVOICE_DATA_DIR=./data
NOVELVOICE_MODEL_DIR=./models
NOVELVOICE_MODEL_AUTO_DOWNLOAD=1
NOVELVOICE_MODEL_REVISION=
NOVELVOICE_TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-Base
NOVELVOICE_TTS_VOICE_DESIGN_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
HF_TOKEN=

# SHUYI_* 是容器入口兼容别名；同名 NOVELVOICE_* 已设置时以后者为准。
SHUYI_DEVICE=cpu
SHUYI_DATA_DIR=./data
SHUYI_MODEL_DIR=./models
SHUYI_MODEL_AUTO_DOWNLOAD=1

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_SEGMENTATION_MODEL=Qwen/Qwen3-8B
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_HARNESS_MODEL=deepseek-v4-flash

QWEN3_TTS_MODEL_PATH=./models/Qwen3-TTS-12Hz-1.7B-Base
QWEN3_TTS_VOICE_DESIGN_MODEL_PATH=./models/Qwen3-TTS-12Hz-1.7B-VoiceDesign
QWEN3_TTS_DEVICE=cpu
QWEN3_TTS_BASE_URL=http://127.0.0.1:7811

# 前端本地开发和 Pages 构建配置。
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_PAGES_BASE_URL=
